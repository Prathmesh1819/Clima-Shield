rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user has admin role
    function isAdmin() {
      return request.auth != null && 
        (request.auth.token.role == 'admin' || 
         get(/databases/$(database)/documents/riders/$(request.auth.uid)).data.role == 'admin');
    }

    // Helper function to check if request is from the resource owner
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // RIDER PROFILES COLLECTION (/riders/{uid})
    match /riders/{uid} {
      // Riders can read their own profile; Admins can read all profiles
      allow read: if isOwner(uid) || isAdmin();
      
      // New riders can register themselves with role = 'rider'
      allow create: if isOwner(uid) && 
        request.resource.data.role == 'rider' &&
        request.resource.data.riderId != null;

      // Riders can update permitted profile fields (cannot change role, riderId, or planId)
      allow update: if (isOwner(uid) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'riderId', 'planId'])) || isAdmin();

      // Deletions restricted to admins
      allow delete: if isAdmin();
    }

    // CLAIMS COLLECTION (/claims/{claimId})
    match /claims/{claimId} {
      // Riders can read their own claims; Admins can read all claims
      allow read: if request.auth != null && 
        (resource.data.riderId == request.auth.uid || isAdmin());

      // Only trusted server/admin can create or update claims
      allow create, update, delete: if isAdmin();
    }

    // PROTECTION PLANS COLLECTION (/plans/{planId})
    match /plans/{planId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

  }
}
